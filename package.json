{
  "name": "react-custom-roulette",
  "version": "1.5.0",
  "description": "Customizable React roulette wheel with spinning animation",
  "main": "./dist/bundle.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/effectussoftware/react-custom-roulette"
  },
  "keywords": [
    "react",
    "custom",
    "roulette",
    "spinning",
    "wheel",
    "fortune",
    "prize"
  ],
  "license": "MIT",
  "types": "./dist/index.d.ts",
  "private": false,
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.9.0",
    "@testing-library/react": "^10.0.6",
    "@testing-library/user-event": "^11.0.0",
    "@types/jest": "^25.2.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-loader": "^9.2.0",
    "css-loader": "^7.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "jest-canvas-mock": "^2.2.0",
    "prettier": "^3.5.0",
    "styled-components": "^6.1.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.8.0",
    "webfontloader": "^1.6.28",
    "webpack": "^5.99.0",
    "webpack-cli": "^6.0.0",
    "webpack-dev-server": "^5.0.0"
  },
  "scripts": {
    "start": "webpack --watch",
    "build": "webpack && tsc && cp -R ./src/assets ./dist",
    "test": "react-scripts test",
    "coverage": "CI=true npm test -- --env=jsdom --coverage",
    "format": "prettier --write src/**/*.{js,ts,tsx}",
    "lint": "eslint src/**/*.{js,ts,tsx}",
    "prepare": "husky"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "src/serviceWorker.ts"
    ]
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
